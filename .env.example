# --- LLM provider -----------------------------------------------------------
# openai | anthropic | gemini | openrouter
LLM_PROVIDER=openai
# Optional: override the default model of the chosen provider (see config/app.yaml)
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# true: refuse to start when the model lacks tool calling / structured output
STRICT_CAPABILITY_CHECK=false
# Stay under your API tier's requests-per-minute limit (empty = unlimited)
LLM_REQUESTS_PER_MINUTE=

# --- Embeddings -------------------------------------------------------------
# local (fastembed, default) | openai | gemini
EMBEDDING_PROVIDER=local
# Default for local: intfloat/multilingual-e5-large
EMBEDDING_MODEL=

# --- Business database (READ-ONLY account) ----------------------------------
# postgres | mysql | mongodb
BUSINESS_DB_TYPE=postgres
BUSINESS_DB_URL=postgresql+asyncpg://support_ro:support_ro@localhost:5432/shop
# Used by the MCP server to sign the caller identity passed over stdio.
# Leave empty to generate a random secret per process.
MCP_PRINCIPAL_SECRET=

# --- Drafts (requests the agent prepares for staff to approve) ----------------
# An account that may write ONLY support_drafts and support_draft_events. Never the read-only shop account.
# Run `support-agent drafts init --url <owner url>` once (with an account that may create tables).
# DRAFTS_DB_URL=postgresql://support_rw:...@localhost:5432/shop

# --- Qdrant (set one) -------------------------------------------------------
# QDRANT_URL=http://localhost:6333
QDRANT_PATH=./data/qdrant

# --- Conversation checkpoints ------------------------------------------------
# Default: SQLite at ./data/checkpoints.db. Postgres: postgresql://user:pass@host/db
# (pip install '.[postgres]'). `memory` keeps nothing across restarts.
# CHECKPOINT_URL=

# --- HTTP API authentication (support-agent serve) -----------------------------
# Your own system issues the JWTs; we only verify them. Claims: the customer id (JWT_CUSTOMER_CLAIM,
# default `sub`), `exp`, and a role claim (JWT_ROLE_CLAIM, default `role`) = customer | staff.
JWT_ALGORITHM=HS256
# HS256: a long random secret shared with the issuer (at least 32 bytes), e.g. `openssl rand -hex 32`
JWT_SECRET=
# RS256: the issuer's JWKS endpoint
# JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# JWT_AUDIENCE=
# JWT_ISSUER=
# JWT_CUSTOMER_CLAIM=sub
# JWT_ROLE_CLAIM=role
# Comma-separated browser origins allowed to call the API (empty = CORS off)
CORS_ORIGINS=

# --- Telling your system about decisions (optional) -------------------------------
# When a request is made or staff decide on it, a signed JSON POST is sent here. See DEPLOY.md.
# Both are needed together. The secret signs every request; your side verifies it.
# WEBHOOK_URL=https://shop.example.com/hooks/support
# WEBHOOK_SECRET=

# --- Sessions and per-session files ---------------------------------------------
# SESSIONS_DB_URL=sqlite:///./data/sessions.db
# WORKSPACE_DIR=./data/workspace

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
